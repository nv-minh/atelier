// VocabMaster — Atelier SRS vocabulary app (Postgres + multi-user)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth (NextAuth v4 + Prisma adapter) ──────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  cards          Card[]
  reviewLogs     ReviewLog[]
  studySessions  StudySession[]
  dailyStats     DailyStat[]
  settings       Settings[]
  wordMarks      WordMark[]
  achievements   Achievement[]
  progress       UserProgress?
  learnerProfile LearnerProfile?

  pushSubscriptions PushSubscription[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Static reference vocabulary ──────────────────────────────────────
model Word {
  id           String  @id @default(cuid())
  word         String  @unique
  cefr         String
  typeEn       String?
  typeVi       String?
  ipaUk        String?
  ipaUs        String?
  definitionEn String?
  definitionVi String?
  extraDefs    String  @default("[]") // JSON array
  example      String?
  exampleVi    String?
  synonyms     String  @default("[]") // JSON array
  antonyms     String  @default("[]") // JSON array
  topics       String  @default("[]") // JSON array of topic slugs
  imageUrl     String?
  audioUk      String?
  audioUs      String?

  // Frequency as a normalized percentile (0..1, 1 = most frequent), NOT a raw
  // rank: pack ranks are per-source and not comparable across lists (`mister`
  // is rank 1 in both BSL and TSL). freqSource records which scale produced it
  // so a percentile can be debugged later without guessing.
  freqPct    Float?
  freqSource String? // "ngsl" | "ngsl-spoken" | "bsl" | "tsl"

  cards     Card[]
  marks     WordMark[]
  createdAt DateTime   @default(now())

  @@index([cefr])
  @@index([cefr, freqPct])
}

// ── Per-user learning state ──────────────────────────────────────────
model Card {
  id     String @id @default(cuid())
  userId String
  wordId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  due           DateTime  @default(now())
  stability     Float     @default(0)
  difficulty    Float     @default(0)
  elapsedDays   Int       @default(0)
  scheduledDays Int       @default(0)
  reps          Int       @default(0)
  lapses        Int       @default(0)
  state         Int       @default(0) // 0=New,1=Learning,2=Review,3=Relearning
  lastReview    DateTime?

  reviews   ReviewLog[]
  createdAt DateTime    @default(now())

  @@unique([userId, wordId])
  @@index([userId, due])
  @@index([userId, state])
}

model ReviewLog {
  id            String   @id @default(cuid())
  cardId        String
  userId        String
  rating        Int // 1=Again,2=Hard,3=Good,4=Easy
  state         Int
  stability     Float
  difficulty    Float
  elapsedDays   Int
  scheduledDays Int
  reviewedAt    DateTime @default(now())

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([userId, reviewedAt])
}

model StudySession {
  id            String    @id @default(cuid())
  userId        String
  mode          String
  cefrFilter    String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  cardsReviewed Int       @default(0)
  correctCount  Int       @default(0)
  durationSec   Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model DailyStat {
  id           String @id @default(cuid())
  userId       String
  dateStr      String
  newCards     Int    @default(0)
  reviews      Int    @default(0)
  timeSec      Int    @default(0)
  correctCount Int    @default(0)
  totalCount   Int    @default(0)
  xp           Int    @default(0) // ReviewLog-derived only (backfill can rebuild this)
  bonusXp      Int    @default(0) // non-SRS mode XP (matching, …); backfill never touches it

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateStr])
  @@index([userId, dateStr])
}

model Settings {
  id               String @id @default(cuid())
  userId           String @unique
  requestRetention Float  @default(0.9)
  newCardsPerDay   Int    @default(20)
  reviewsPerDay    Int    @default(200)
  theme            String @default("system")
  dailyGoalXp      Int    @default(60)

  // ── Study reminders ───────────────────────────────────────────────
  // remindHour: LOCAL hour 0–23; null = reminders off, which is what every
  // existing row has, so nobody gets switched on silently when this ships.
  remindHour Int?
  // IANA zone, not a minute offset: a stored offset is wrong on the day DST changes.
  tz         String @default("Asia/Ho_Chi_Minh")
  // A DERIVED pointer, and a deliberate exception to the "Settings = what the
  // user set by hand" rule. It lives here because the "one reminder per day" cap
  // is enforced by a single conditional update on this very row (see
  // /api/cron/reminders); in a separate table the cron would have to join and
  // then write in two places, and the most important property of the feature
  // would rest on those two writes never drifting apart.
  nextRemindAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nextRemindAt])
}

// One learner can have several devices, so this cannot live on Settings.
model PushSubscription {
  id        String    @id @default(cuid())
  userId    String
  endpoint  String    @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime  @default(now())
  lastOkAt  DateTime?
  failCount Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Gamification: XP total + unlocked achievements ───────────────────
// Level is NOT stored — it is derived from xp via levelFromXp (gamification-defs).
model UserProgress {
  id           String    @id @default(cuid())
  userId       String    @unique
  xp           Int       @default(0) // ReviewLog-derived only (backfill can rebuild this)
  bonusXp      Int       @default(0) // non-SRS mode XP (matching, …); backfill never touches it
  backfilledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  key        String // "streak_7", "reviews_1000", "cefr_A1", ...
  unlockedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Race-safety anchor: a duplicate insert (concurrent unlock) hits P2002 and
  // is caught by the awarder, so a badge can never be granted twice. The unique
  // index also serves userId-prefixed lookups (findMany where userId), so no
  // separate @@index([userId]) is needed.
  @@unique([userId, key])
}

// ── Level & interests: what the system inferred about a learner ──────
// Separate from Settings on purpose, following the split the repo already has:
// Settings = what the user set by hand; UserProgress/LearnerProfile = what the
// system derived and can recompute.
model LearnerProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  // Continuous CEFR scale A1=0 → C1=4. Float, not an enum, so drift can move
  // half a band instead of jumping a whole one.
  band             Float     @default(2)
  vocabSizeEst     Int       @default(0)
  topics           String    @default("[]") // JSON array of slugs, same convention as Word.topics
  source           String    @default("declared") // "test" | "drift" | "declared"
  // Bumped when REFERENCE_BAND_SIZE changes: old and new estimates are then
  // two different scales, and comparing them silently would be wrong.
  estimatorVersion Int       @default(1)
  lastTest         String? // JSON items + answers of the most recent test
  placedAt         DateTime?
  driftedAt        DateTime? // gates drift to at most once per day
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Per-user notebook: bookmarks ("star") + personal notes ───────────
model WordMark {
  id        String   @id @default(cuid())
  userId    String
  wordId    String
  starred   Boolean  @default(false)
  note      String   @default("")
  // "I already know this word" — an explicit user signal (placement test answer
  // or the button on a word). Lives here because WordMark already *is* the
  // user's opinion about a word. Must stay reversible: the selection engine
  // only de-prioritizes known words, it never deletes them.
  known     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, starred])
  @@index([userId, known])
}
