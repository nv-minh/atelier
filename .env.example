# Atelier — environment template.
#
# Copy to `.env` and fill in. Names only here, never values: this file IS
# committed (see the `!.env.example` negation in .gitignore), every other
# .env* is not.
#
# The 12 variables below are exactly what production holds. Deployment notes,
# including where each secret comes from, are in DEPLOY.md.

# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string. Neon in production; any Postgres works locally.
DATABASE_URL=

# ── Auth (NextAuth) ─────────────────────────────────────────────────────────
# Random 32+ byte secret:  openssl rand -base64 32
NEXTAUTH_SECRET=
# The site's own origin. http://localhost:3000 in development. Must match the
# redirect URIs registered with the OAuth providers below, exactly.
NEXTAUTH_URL=

# Google sign-in. Both must be set or the provider is not registered at all and
# /login shows a disabled button. Redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in. Legacy: the button was removed from /login, but the provider
# stays registered so pre-Google accounts are not orphaned. Safe to leave empty
# on a fresh install.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Study reminders (web push) ──────────────────────────────────────────────
# Generate a key pair:  npx web-push generate-vapid-keys
# Missing keys disable push silently — the app logs once and carries on.
# ⚠️ Never rotate these on a live deployment: every existing subscription dies
#    at once, and dead rows are only pruned lazily on a 404/410.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Same value as VAPID_PUBLIC_KEY — the client needs it at subscribe time.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Contact for push services, as `mailto:you@example.com` or an https:// URL.
VAPID_SUBJECT=

# Bearer token guarding /api/cron/reminders. Must be identical here and in the
# GitHub repo secret of the same name, or the hourly workflow gets a 401.
CRON_SECRET=

# ── Optional ────────────────────────────────────────────────────────────────
# Canonical origin for metadata, Open Graph, robots.txt and sitemap.xml. Unset
# falls back to the current production URL hard-coded in src/app/layout.tsx.
# Set this when moving to a custom domain — that is the whole migration.
NEXT_PUBLIC_SITE_URL=

# Address published on /privacy and /terms for contact and account deletion.
# ⚠️ Must be a monitored mailbox before the site goes public: /privacy promises
#    to action deletion requests within 30 days, and Google's OAuth consent
#    review reads that page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Dev only. Skips auth and signs you in as a shared local user. Hard-guarded
# against NODE_ENV=production in src/lib/session.ts.
AUTH_BYPASS=

# Build scripts only (scripts/images/*), never read at runtime.
PEXELS_API_KEY=
