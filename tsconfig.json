{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/tmp is gitignored throwaway probes written next to whatever branch
  // they were debugging, so they routinely import symbols that exist only on
  // that branch. Type-checking them makes `tsc --noEmit` fail on every OTHER
  // branch for reasons that have nothing to do with the code being changed.
  "exclude": ["node_modules", "scripts/tmp"]
}
